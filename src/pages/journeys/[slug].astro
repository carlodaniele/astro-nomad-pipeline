---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const [journeys, posts] = await Promise.all([getCollection('journeys'), getCollection('blog')]);

	return journeys.flatMap((journey) => {
		const journeyPosts = posts
			.filter((post) => post.data.journey === journey.id)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

		if (journeyPosts.length === 0) return [];

		return [{ params: { slug: journey.id }, props: { journey, posts: journeyPosts } }];
	});
}

type Props = {
	journey: CollectionEntry<'journeys'>;
	posts: CollectionEntry<'blog'>[];
};

const { journey, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${journey.data.title} | ${SITE_TITLE}`} description={journey.data.description} />
	</head>
	<body>
		<Header />
		<main>
			<PageHero
				image={journey.data.heroImage}
				imageAlt={`${journey.data.title} landscape`}
				title={journey.data.title}
				description={journey.data.description}
			>
				{journey.data.region} · {posts.length} {posts.length === 1 ? 'story' : 'stories'}
			</PageHero>

			<section class="stories" aria-labelledby="stories-title">
				<div class="stories-heading">
					<p class="eyebrow">The route, in notes</p>
					<h2 id="stories-title">Field notes</h2>
				</div>
				<div class="story-list">
					{posts.map((post, index) => (
						<article class="story">
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image
										class="story-image"
										src={post.data.heroImage}
										alt={`${post.data.title} article image`}
										width={720}
										height={440}
										loading="lazy"
									/>
								)}
								<div class="story-copy">
									<p class="story-number">FIELD NOTE 0{index + 1}</p>
									<p class="story-date"><FormattedDate date={post.data.pubDate} /></p>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="read-link">Read story <span aria-hidden="true">↗</span></span>
								</div>
							</a>
						</article>
					))}
				</div>
				<a class="back-link" href="/journeys/">← All journeys</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #f7f6f1;
		color: #26362f;
	}
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
	.eyebrow,
	.story-number {
		margin: 0 0 12px;
		color: #9a5d35;
		font-size: 13px;
		font-weight: 700;
		text-transform: uppercase;
	}
	.stories {
		width: min(1000px, calc(100% - 64px));
		margin: 0 auto;
		padding: 66px 0 92px;
	}
	.stories-heading {
		margin-bottom: 24px;
	}
	.stories-heading h2 {
		margin: 0;
		color: #26362f;
		font-size: 38px;
	}
	.story {
		border-top: 1px solid #c9c7bc;
	}
	.story > a {
		display: grid;
		grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);
		gap: 30px;
		padding: 22px 0;
		color: inherit;
		text-decoration: none;
	}
	.story-image {
		width: 100%;
		height: 100%;
		max-height: 270px;
		object-fit: cover;
	}
	.story-copy {
		align-self: center;
	}
	.story-number {
		margin-bottom: 5px;
	}
	.story-date {
		margin: 0 0 10px;
		color: #68756d;
		font-size: 14px;
	}
	.story h3 {
		margin: 0 0 8px;
		color: #26362f;
		font-size: 25px;
		line-height: 1.2;
	}
	.story-copy > p:not(.story-number, .story-date) {
		margin: 0;
		color: #59655e;
		font-size: 16px;
	}
	.read-link {
		display: inline-flex;
		gap: 8px;
		margin-top: 13px;
		color: #26362f;
		font-size: 14px;
		font-weight: 700;
	}
	.back-link {
		display: inline-block;
		margin-top: 34px;
		color: #26362f;
		font-size: 15px;
		font-weight: 700;
		text-decoration-color: #9a5d35;
		text-underline-offset: 5px;
	}
	@media (max-width: 620px) {
		.stories {
			width: calc(100% - 40px);
		}
		.story > a {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
		}
		.story-image {
			max-height: 240px;
		}
	}
</style>